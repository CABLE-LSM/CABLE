spack:
  specs:
  - cable@git.{{ ref }}
  packages:
    gcc:
      require:
      - '@{{ gcc_compiler_ver }}'
    all:
      require:
      - '%access_gcc'  # https://github.com/ACCESS-NRI/spack-config/blob/main/v1.1/toolchains.yaml
      - target={{ target }}
  concretizer:
    unify: false
  view: false
